server {
    listen {{ nginx_port }};
    server_name {{ lighthouse_domain }};

    root {{ lighthouse_dir }};
    index index.html;

    location / {
        try_files $uri $uri/ =404;
    }

    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg)$ {
        expires 30d;
        add_header Cache-Control "public, immutable";
    }

    location ~ /\.git {
        deny all;
    }
}
